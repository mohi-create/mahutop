---
import { getLangFromUrl, useTranslations } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "MahuTop - The Unclonable Full-Stack Powerhouse Market." } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Comprehensive Brand Identity Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Brand",
  "name": "MahuTop",
  "alternateName": ["mahu", "mahutop", "ماهوتوب"],
  "description": "The supreme international electronic badge and cyberpunk wearable asset ecosystem.",
  "url": Astro.site ? Astro.site.toString() : "https://mahutop.com"
};
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} class="bg-[#050507] text-slate-100 overflow-x-hidden selection:bg-amber-500 selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title} | MahuTop</title>
    <meta name="description" content={description} />
    
    <!-- Fluid Typography Engine via Universal Native CSS Clamping -->
    <style>
      :root {
        --fluid-text-hero: clamp(2.5rem, 6vw + 1rem, 6.5rem);
        --fluid-text-title: clamp(1.75rem, 4vw + 1rem, 3.5rem);
        --fluid-text-base: clamp(0.875rem, 0.5vw + 0.75rem, 1.125rem);
      }
      .font-fluid-hero { font-size: var(--fluid-text-hero); line-height: 1.1; }
      .font-fluid-title { font-size: var(--fluid-text-title); line-height: 1.2; }
      .font-fluid-base { font-size: var(--fluid-text-base); line-height: 1.6; }
    </style>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Orbitron:wght@400;700;900&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="min-h-screen flex flex-col relative antialiased font-['Inter'] font-fluid-base">
    
    <!-- Zero-Flicker Background Grid Layers -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-950/15 via-neutral-950 to-[#050507] pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#d4af3705_1px,transparent_1px),linear-gradient(to_bottom,#d4af3705_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none z-0"></div>

    <!-- Sovereign Header Anchor -->
    <header class="border-b border-amber-500/10 bg-[#050507]/70 backdrop-blur-xl relative z-50 sticky top-0 w-full h-20 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">
        <a href={`/${lang}`} class="flex items-center space-x-2 rtl:space-x-reverse group logo-trigger">
          <span class="font-['Cinzel'] text-2xl tracking-[0.25em] bg-gradient-to-r from-amber-400 via-yellow-200 to-amber-500 bg-clip-text text-transparent font-black uppercase transition-all duration-300 drop-shadow-[0_0_12px_rgba(245,158,11,0.2)]">
            MahuTop
          </span>
          <span class="font-['Orbitron'] text-[9px] text-amber-500/50 tracking-widest border border-amber-500/20 px-1.5 py-0.5 rounded backdrop-blur-sm">
            SECURE
          </span>
        </a>

        <nav class="hidden md:flex items-center space-x-8 rtl:space-x-reverse">
          <a href={`/${lang}`} class="nav-item font-['Orbitron'] text-xs uppercase tracking-[0.2em] text-slate-400 hover:text-amber-400 transition-colors duration-300">{t('nav.home')}</a>
          <a href={`/${lang}/admin`} class="nav-item font-['Orbitron'] text-xs uppercase tracking-[0.2em] text-amber-500/60 hover:text-amber-400 transition-colors duration-300">{t('nav.admin')}</a>
        </nav>

        <div class="flex items-center">
          <select id="langSwitcher" class="bg-neutral-950 border border-amber-500/20 text-xs text-amber-400 focus:outline-none focus:border-amber-500 rounded px-2.5 py-1.5 font-['Orbitron'] tracking-widest cursor-pointer hover:bg-neutral-900 transition-colors">
            <option value="en" selected={lang === 'en'}>EN</option>
            <option value="ar" selected={lang === 'ar'}>AR</option>
          </select>
        </div>
      </div>
    </header>

    <main class="flex-grow relative z-10 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <slot />
    </main>

    <footer class="border-t border-amber-500/5 bg-[#030305] relative z-10 py-10 text-center text-[10px] tracking-[0.3em] font-['Orbitron'] text-neutral-600">
      <p>&copy; 2026 MAHUTOP SYSTEMS. IMMUTABLE ARCHITECTURE. ALL RIGHTS RESERVED.</p>
    </footer>

    <!-- INTERACTIVE ZERO-DEPENDENCY CLIENT-SIDE SYNTH AUDIO ENGINE -->
    <script>
      let audioCtx: AudioContext | null = null;

      function initAudio() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
      }

      (window as any).playCyberSound = function(type: 'click' | 'cart' | 'hover') {
        try {
          initAudio();
          if (!audioCtx || audioCtx.state === 'suspended') {
            audioCtx?.resume();
          }
          
          const ctx = audioCtx!;
          const now = ctx.currentTime;

          if (type === 'click') {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(850, now);
            osc.frequency.exponentialRampToValueAtTime(180, now + 0.06);
            gain.gain.setValueAtTime(0.1, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.06);
          } 
          
          else if (type === 'cart') {
            // High-Value Cascading Gold Audio Array Sequence
            const tones = [523.25, 659.25, 783.99, 1046.50, 1318.51];
            tones.forEach((freq, i) => {
              const strikeTime = now + (i * 0.05);
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              osc.type = 'sine';
              osc.frequency.setValueAtTime(freq, strikeTime);
              gain.gain.setValueAtTime(0.12, strikeTime);
              gain.gain.exponentialRampToValueAtTime(0.002, strikeTime + 0.3);
              osc.connect(gain);
              gain.connect(ctx.destination);
              osc.start(strikeTime);
              osc.stop(strikeTime + 0.3);
            });
          }
          
          else if (type === 'hover') {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(95, now);
            gain.gain.setValueAtTime(0.02, now);
            gain.gain.linearRampToValueAtTime(0.0001, now + 0.12);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.12);
          }
        } catch (e) {
          console.warn("Audio Context suppressed via standard platform configuration flags.", e);
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a, select, button').forEach(el => {
          el.addEventListener('click', () => (window as any).playCyberSound?.('click'));
        });

        document.querySelectorAll('.nav-item, .logo-trigger').forEach(el => {
          el.addEventListener('mouseenter', () => (window as any).playCyberSound?.('hover'));
        });

        const switcher = document.getElementById('langSwitcher') as HTMLSelectElement;
        if (switcher) {
          switcher.addEventListener('change', (e) => {
            const targetLang = (e.target as HTMLSelectElement).value;
            const segments = window.location.pathname.split('/');
            if (['en', 'ar', 'es'].includes(segments[1])) {
              segments[1] = targetLang;
            } else {
              segments.splice(1, 0, targetLang);
            }
            window.location.pathname = segments.join('/');
          });
        }
      });
    </script>
  </body>
</html>
