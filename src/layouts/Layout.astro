<!doctype html>
<html lang={renderedLang} dir={renderedLang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Pre-paint: set lang/dir before first paint to avoid flicker -->
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('mahutop-lang') || 'en';
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        if (lang === 'ar') {
          document.documentElement.classList.add('lang-ar');
        } else {
          document.documentElement.classList.remove('lang-ar');
        }
      })();
    </script>

    <style is:global>
      /* ── Reset & Base ─────────────────────────────────────── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #060a10;
        color: #e6eef6;
        -webkit-font-smoothing: antialiased;
      }

      html.lang-ar {
        font-family: 'Segoe UI', 'Tahoma', 'Arial', sans-serif;
      }

      body {
        min-height: 100vh;
        padding: 2rem 1.5rem;
      }

      a { color: inherit; }

      /* ── Navigation Bar ───────────────────────────────────── */
      .site-nav {
        max-width: 1200px;
        margin: 0 auto 2.5rem;
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 1rem 1.5rem;
        border: 1px solid rgba(56, 189, 248, 0.12);
        border-radius: 14px;
        background: rgba(9, 12, 18, 0.9);
      }

      html[dir="rtl"] .site-nav {
        flex-direction: row-reverse;
      }

      .site-nav .brand {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #38bdf8;
        text-decoration: none;
        white-space: nowrap;
      }

      .site-nav .nav-center {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        flex: 1;
        justify-content: center;
      }

      .site-nav .nav-center a {
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #94a3b8;
        text-decoration: none;
        transition: color 0.2s ease;
        white-space: nowrap;
      }

      .site-nav .nav-center a:hover,
      .site-nav .nav-center a.active {
        color: #38bdf8;
      }

      /* ── Language Switcher ────────────────────────────────── */
      .lang-switcher {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-left: auto;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 8px;
        padding: 0.3rem;
        cursor: pointer;
        user-select: none;
        flex-shrink: 0;
      }

      html[dir="rtl"] .lang-switcher {
        margin-left: 0;
        margin-right: auto;
      }

      .lang-btn {
        padding: 0.35rem 0.7rem;
        border-radius: 6px;
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: all 0.2s ease;
