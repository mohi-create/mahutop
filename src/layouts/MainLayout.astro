---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="bg-[#06070a] text-gray-100 dark" style="background-color: #06070a;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#06070a] text-gray-100 min-h-screen selection:bg-emerald-500 selection:text-black" style="background-color: #06070a;">

  <div class="system-shell p-4 max-w-7xl mx-auto">
    <!-- Language Switcher -->
    <div class="flex justify-end mb-4">
      <select id="lang-toggle" class="bg-slate-900 border border-slate-800 text-white text-sm rounded-md px-3 py-1 outline-none cursor-pointer z-50 relative">
        <option value="en">EN</option>
        <option value="ar">AR</option>
      </select>
    </div>

    <slot />
  </div>

  <script>
    // @ts-nocheck
    const translations: Record<string, Record<string, string>> = {
      en: {
        homeTitle: "SOVEREIGN SYSTEM CORE // MAIN_MENU",
        systemStatus: "SYSTEM OPERATIONAL // LATENCY 0ms // MODULES FULLY DEPLOYED",
        launchVaultBtn: "LAUNCH VAULT ENGINE",
        launchVaultDesc: "Execute Arabic character normalization, text diacritic stripping, and bulk text, PDF, or Word document processing rules.",
        accessReviewsBtn: "ACCESS REVIEWS DATABASE",
        accessReviewsDesc: "Browse encrypted local file logs, development audits, and markdown system documentation.",
        vaultTitle: "SOVEREIGN // VAULT_CORE",
        diagnosticsTitle: "System Diagnostics",
        vaultSub: "Secure structural system processing rules, multi-language character configuration files, and system parameters.",
        logsTitle: "SYSTEM LOGS // REVIEWS_DATABASE",
        reviewsSub: "Encrypted review logs, ready for audit and deeper analysis.",
        bazaarTitle: "AFFILIATE MATRIX",
        bazaarSub: "Curated premium storefront — time-limited offers auto-expire.",
        secElectronics: "01 // ELECTRONICS & TECHNOLOGY [PERFORMANCE BENCHMARKS]",
        secHome: "02 // HOME & KITCHEN [BUYING GUIDES & SETUPS]",
        secFashion: "03 // FASHION & ACCESSORIES [STYLE RECOMMENDATIONS]",
        secHealth: "04 // HEALTH & PERSONAL CARE [EXPERT ROUTINES]",
        secAssistant: "05 // AI SHOPPING ASSISTANT SIMULATION DASHBOARD",
        assistantDesc: "Type your goal in plain language and receive an instant, curated component breakdown with pricing and affiliate routing.",
        assistantLabel: "Your goal",
        assistantBtn: "Generate Shopping Plan",
        assistantEmpty: "Enter a goal above and press Generate to see a premium recommendation roadmap.",

        // Product Items English Content
        p1Title: "Pro Compute Core Rig",
        p1Desc: "Benchmark: Optimized for local Dolphin3 & LLM execution.",
        p1Btn: "BUY VIA AFFILIATE",
        p2Title: "Ergonomic Workspace Command Desk",
        p2Desc: "Setup: Perfect minimalist cable-managed layout.",
        p2Btn: "View Deal →",
        p3Title: "Tactical Cyber-Shell Parka",
        p3Desc: "Style: Matte-black weatherized utility outer shell.",
        p3Btn: "SECURE ITEM",
        p4Title: "Smart Nootropic Focus Stacks",
        p4Desc: "Routine: Morning execution matrix for deep focus work.",
        p4Btn: "ACQUIRE SUPPLY",
        offerEnds: "OFFER ENDS:",
        limitedLog: "LIMITED LOG:"
      },
      ar: {
        homeTitle: "نواة نظام السيادة // القائمة الرئيسية",
        systemStatus: "النظام يعمل بنجاح // زمن الاستجابة 0 ملّي ثانية // الوحدات مفعّلة بالكامل",
        launchVaultBtn: "تشغيل محرك الخزنة",
        launchVaultDesc: "تنفيذ قواعد معالجة النصوص، وتطبيع الحروف العربية، وإزالة التشكيل، ومعالجة ملفات PDF والـ Word بشكل جماعي.",
        accessReviewsBtn: "دخول قاعدة بيانات المراجعات",
        accessReviewsDesc: "تصفح سجلات الملفات المحلية المشفرة، عمليات تدقيق التطوير، وتوثيق النظام المكتوب بصيغة ماركداون.",
        vaultTitle: "خزنة السيادة // النواة الرئيسية",
        diagnosticsTitle: "تشخيصات النظام المختصة",
        vaultSub: "قواعد معالجة هيكلية آمنة للنظام، ملفات تكوين الحروف متعددة اللغات، ومعلمات النظام.",
        logsTitle: "سجلات النظام // قاعدة بيانات المراجعات",
        reviewsSub: "سجلات المراجعة المشفرة، جاهزة للتدقيق والتحليل العميق.",
        bazaarTitle: "مصفوفة التسويق بالعمولة",
        bazaarSub: "متجر مخصص مميز — العروض المحدودة بوقت تنتهي تلقائيًا.",
        secElectronics: "01 // الإلكترونيات والتكنولوجيا [معايير الأداء المتقدمة]",
        secHome: "02 // المنزل والمطبخ [أدلة الشراء وإعدادات التصميم]",
        secFashion: "03 // الأزياء والإكسسوارات [توصيات الأناقة العصرية]",
        secHealth: "04 // الصحة والعناية الشخصية [الروتين اليومي المتقدم]",
        secAssistant: "05 // لوحة تحكم محاكاة مساعد التسوق الذكي",
        assistantDesc: "اكتب هدفك بلغة بسيطة واحصل على خطة تفصيلية فورية للمكونات مع الأسعار والتوجيه المباشر للروابط.",
        assistantLabel: "هدفك الحالي",
        assistantBtn: "توليد خطة التسوق",
        assistantEmpty: "أدخل هدفك أعلاه واضغط على زر التوليد لرؤية خارطة الطريق الموصى بها.",

        // Product Items Arabic Content
        p1Title: "منصة الحاسوب الاحترافية المتكاملة",
        p1Desc: "المعيار الأساسي: مُحسّن تمامًا لتشغيل نماذج وذكاء Dolphin3 و LLM محليًا.",
        p1Btn: "شراء عبر الرابط",
        p2Title: "مكتب القيادة المريح لمساحة العمل",
        p2Desc: "الإعداد: تصميم بسيط مثالي لترتيب وإخفاء الكابلات تمامًا.",
        p2Btn: "عرض الصفقة ←",
        p3Title: "سترة الحماية التكتيكية المقاومة للطقس",
        p3Desc: "الأناقة: غلاف خارجي متين باللون الأسود المطفي ومقاوم للعوامل الجوية.",
        p3Btn: "تأمين المنتج الآن",
        p4Title: "مكملات التركيز الذهني الذكية (Nootropic)",
        p4Desc: "الروتين: مصفوفة التنفيذ الصباحية للوصول لحالة التركيز العميق بالعمل.",
        p4Btn: "احصل على الإمداد",
        offerEnds: "ينتهي العرض خلال:",
        limitedLog: "سجل محدود:"
      }
    };

    type Lang = 'en' | 'ar';

    function applyTranslations(lang: Lang): void {
      document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
      document.documentElement.lang = lang;

      const dynamicElements = document.querySelectorAll<HTMLElement>('[data-i18n-key]');
      dynamicElements.forEach((el) => {
        const key = el.dataset['i18nKey'];
        if (key && translations[lang] && translations[lang][key]) {
          el.textContent = translations[lang][key];
        }
      });
    }

    function setupLanguage(): void {
      const langToggle = document.getElementById('lang-toggle') as HTMLSelectElement | null;
      if (langToggle) {
        langToggle.addEventListener('change', (e: Event) => {
          const target = e.target as HTMLSelectElement;
          const selectedLang = target.value as Lang;
          localStorage.setItem('mahutop_lang', selectedLang);
          applyTranslations(selectedLang);
        });

        const savedLang = (localStorage.getItem('mahutop_lang') || 'en') as Lang;
        langToggle.value = savedLang;
        applyTranslations(savedLang);
      }
    }

    document.addEventListener('DOMContentLoaded', setupLanguage);
    setupLanguage();
  </script>
</body>
</html>

<style is:global>
  :root, html, body {
    background-color: #06070a !important;
    color: #e6eef6 !important;
    background: #06070a !important;
  }
</style>
