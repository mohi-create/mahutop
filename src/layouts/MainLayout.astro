---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="bg-black text-gray-100">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <!-- Tailwind CDN to ensure all dark modes, grids, and emerald accents render everywhere -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-gray-100 min-h-screen selection:bg-emerald-500 selection:text-black">
  
  <!-- Master Site Shell Context Layout -->
  <div class="system-shell p-4 max-w-7xl mx-auto">
    <slot />
  </div>

  <script>
    interface TranslationDictionary {
      [key: string]: { [key: string]: string };
    }

    const translations: TranslationDictionary = {
      en: {
        brand: "MAHUTOP",
        home: "HOME_BASE",
        vault: "SOVEREIGN // VAULT_CORE",
        bazaar: "GRAND BAZAAR",
        logs: "SYSTEM LOGS // REVIEWS_DATABASE",
        reviewsSub: "Encrypted review logs, ready for audit and deeper analysis."
      },
      ar: {
        brand: "ماهوتوب",
        home: "الصفحة الرئيسية",
        vault: "خزنة السيادة // النواة المسبقة",
        bazaar: "البازار الكبير",
        logs: "سجلات النظام // قاعدة بيانات المراجعات",
        reviewsSub: "سجلات المراجعة المشفرة، جاهزة للتدقيق والتحليل العميق."
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      const langToggle = document.getElementById('lang-toggle') as HTMLSelectElement | null;
      
      function applyTranslations(lang: 'en' | 'ar') {
        document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        document.documentElement.lang = lang;

        const dynamicElements = document.querySelectorAll('[data-i18n-key], [data-key]');
        dynamicElements.forEach((el) => {
          const htmlEl = el as HTMLElement;
          const rawKey = htmlEl.dataset.i18nKey || htmlEl.dataset.key || htmlEl.textContent || "";
          const cleanKey = rawKey.trim().replace(/\s+/g, ' ');

          if (translations[lang] && translations[lang][cleanKey]) {
            htmlEl.textContent = translations[lang][cleanKey];
          }
        });
      }

      if (langToggle) {
        langToggle.addEventListener('change', (e: Event) => {
          const target = e.target as HTMLSelectElement;
          const selectedLang = target.value as 'en' | 'ar';
          localStorage.setItem('mahutop_lang', selectedLang);
          applyTranslations(selectedLang);
        });

        const savedLang = (localStorage.getItem('mahutop_lang') || 'en') as 'en' | 'ar';
        langToggle.value = savedLang;
        applyTranslations(savedLang);
      }
    });
  </script>
</body>
</html>
