---
import Navbar from '../components/Navbar.astro';
const { title = "Sovereign Core System" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <slot />
  </body>
</html>

<style is:global>
  body {
    background-color: #0d1117;
    color: #c9d1d9;
    font-family: monospace;
    margin: 0;
    padding: 0;
  }
</style>
