---
import Navbar from '../components/Navbar.astro';
const { frontmatter } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{frontmatter.title}</title>
</head>
<body>
  <Navbar />
  <main style="max-width: 800px; margin: 40px auto; padding: 0 20px; font-family: monospace; color: #c9d1d9; background-color: #0d1117;">
    <h1 style="color: #58a6ff; border-bottom: 1px solid #30363d; padding-bottom: 10px;">{frontmatter.title}</h1>
    <p style="color: #8b949e; font-size: 0.9rem;">LOG DATE: {frontmatter.date}</p>
    <article>
      <slot />
    </article>
  </main>
</body>
</html>
<style is:global>
  body { background-color: #0d1117; color: #c9d1d9; }
</style>
