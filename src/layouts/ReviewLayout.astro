---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title + ' | MahuTop'}>
  <main class="max-w-4xl mx-auto mt-10 px-4 font-mono">
    <h1 class="text-2xl text-blue-400 border-b border-slate-800 pb-3 uppercase font-bold mb-2">
      {frontmatter.title}
    </h1>
    <p class="text-slate-500 text-sm mb-6">LOG DATE: {frontmatter.date}</p>
    
    <article class="leading-relaxed text-slate-300 bg-slate-950 p-6 border border-slate-900 rounded-md">
      <slot />
    </article>
  </main>
</Layout>