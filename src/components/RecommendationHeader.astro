---
interface RecommendationItem {
  category: string;
  type: 'best-seller' | 'best-price' | 'best-viewed' | 'best-offer';
  title: string;
  price: string | number;
  affiliateLink: string;
}

interface Props {
  items: RecommendationItem[];
}

const { items = [] } = Astro.props;

// Detect text direction based on content (simple heuristic for Arabic)
const detectDirection = (text: string): 'rtl' | 'ltr' => {
  const arabicRegex = /[\u0600-\u06FF]/;
  return arabicRegex.test(text) ? 'rtl' : 'ltr';
};

// Get badge styling based on type
const getBadgeClass = (type: string): string => {
  const baseClass = 'badge badge-';
  switch (type) {
    case 'best-seller':
      return baseClass + 'best-seller';
    case 'best-offer':
      return baseClass + 'best-offer';
    case 'best-price':
      return baseClass + 'best-price';
    case 'best-viewed':
      return baseClass + 'best-viewed';
    default:
      return baseClass + 'default';
  }
};

// Format badge label
const getBadgeLabel = (type: string): string => {
  const labels: Record<string, string> = {
    'best-seller': 'Best Seller',
    'best-offer': 'Best Offer',
    'best-price': 'Best Price',
    'best-viewed': 'Best Viewed',
  };
  return labels[type] || 'Featured';
};
---

<div class="recommendation-header">
  <div class="container">
    <div class="grid-wrapper">
      {items.map((item) => {
        const direction = detectDirection(item.title);
        return (
          <div 
            class={`recommendation-card ${getBadgeClass(item.type)}`}
            dir={direction}
          >
            {/* Badge */}
            <div class={`badge-container ${item.type}`}>
              <span class="badge-text">{getBadgeLabel(item.type)}</span>
            </div>

            {/* Content */}
            <div class="card-content">
              <div class="category-tag">{item.category}</div>
              
              <h3 class="product-title">{item.title}</h3>
              
              <div class="price-section">
                <span class="price-label">
                  {direction === 'rtl' ? 'السعر' : 'Price'}
                </span>
                <span class="price-value">{item.price}</span>
              </div>

              <a 
                href={item.affiliateLink}
                class="cta-button"
                target="_blank"
                rel="noopener noreferrer"
              >
                {direction === 'rtl' ? 'استكشف الآن' : 'Explore Now'}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<style>
  :root {
    --color-crimson: #dc143c;
    --color-emerald: #00ff88;
    --color-silver: #c0c0c0;
    --color-sapphire: #0066ff;
    --color-bg-dark: #0f172a;
    --color-text-primary: #ffffff;
    --color-text-secondary: #94a3b8;
    --shadow-premium: 0 20px 60px rgba(0, 0, 0, 0.5);
    --transition-smooth: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .recommendation-header {
    width: 100%;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.6) 100%);
    padding: 3rem 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .grid-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  /* Base Card Styling */
  .recommendation-card {
    position: relative;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
    border-radius: 12px;
    padding: 1.5rem;
    overflow: hidden;
    transition: var(--transition-smooth);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .recommendation-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-premium);
  }

  /* Badge Container */
  .badge-container {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem 0.875rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    z-index: 10;
  }

  /* RTL Badge Positioning */
  [dir="rtl"] .badge-container {
    right: auto;
    left: 1rem;
  }

  /* Best Seller - Crimson Highlight */
  .badge-container.best-seller {
    background: rgba(220, 20, 60, 0.1);
    border: 2px solid var(--color-crimson);
    color: var(--color-crimson);
    box-shadow: 0 0 20px rgba(220, 20, 60, 0.3), inset 0 0 20px rgba(220, 20, 60, 0.1);
  }

  .recommendation-card.badge-best-seller {
    border-left: 4px solid var(--color-crimson);
    border-image: linear-gradient(180deg, var(--color-crimson), rgba(220, 20, 60, 0.2)) 1;
  }

  /* Best Offer - Neon Emerald Glowing Pulse */
  .badge-container.best-offer {
    background: rgba(0, 255, 136, 0.15);
    border: 2px solid var(--color-emerald);
    color: var(--color-emerald);
    animation: pulse-glow 2s ease-in-out infinite;
    box-shadow: 0 0 30px rgba(0, 255, 136, 0.4), inset 0 0 20px rgba(0, 255, 136, 0.1);
  }

  .recommendation-card.badge-best-offer {
    border-top: 3px solid var(--color-emerald);
    box-shadow: inset 0 -1px 0 rgba(0, 255, 136, 0.2), 0 0 40px rgba(0, 255, 136, 0.1);
  }

  /* Best Price - Matte Silver Minimalist */
  .badge-container.best-price {
    background: rgba(192, 192, 192, 0.05);
    border: 1px solid var(--color-silver);
    color: var(--color-silver);
    box-shadow: none;
  }

  .recommendation-card.badge-best-price {
    border: 1px solid rgba(192, 192, 192, 0.3);
  }

  /* Best Viewed - Sapphire Blue Cyber */
  .badge-container.best-viewed {
    background: rgba(0, 102, 255, 0.1);
    border: 2px solid var(--color-sapphire);
    color: var(--color-sapphire);
    box-shadow: 0 0 15px rgba(0, 102, 255, 0.3), inset 0 0 15px rgba(0, 102, 255, 0.05);
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  .recommendation-card.badge-best-viewed {
    border-right: 3px solid var(--color-sapphire);
  }

  /* Card Content */
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .category-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .product-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.4;
    word-break: break-word;
  }

  /* Price Section */
  .price-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: rgba(148, 163, 184, 0.05);
    border-radius: 8px;
  }

  .price-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .price-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  /* CTA Button */
  .cta-button {
    display: inline-block;
    padding: 0.875rem 1.5rem;
    background: linear-gradient(135deg, rgba(0, 102, 255, 0.8) 0%, rgba(0, 66, 204, 0.8) 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    transition: var(--transition-smooth);
    border: 1px solid rgba(0, 102, 255, 0.3);
    cursor: pointer;
  }

  .cta-button:hover {
    background: linear-gradient(135deg, rgba(0, 102, 255, 1) 0%, rgba(0, 66, 204, 1) 100%);
    box-shadow: 0 10px 30px rgba(0, 102, 255, 0.3);
    transform: translateY(-2px);
  }

  .cta-button:active {
    transform: translateY(0);
  }

  /* Animations */
  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 30px rgba(0, 255, 136, 0.4), inset 0 0 20px rgba(0, 255, 136, 0.1);
    }
    50% {
      box-shadow: 0 0 50px rgba(0, 255, 136, 0.6), inset 0 0 30px rgba(0, 255, 136, 0.15);
    }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .recommendation-header {
      padding: 2rem 0.75rem;
    }

    .grid-wrapper {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .product-title {
      font-size: 1rem;
    }

    .price-value {
      font-size: 1.5rem;
    }

    .badge-container {
      top: 0.75rem;
      right: 0.75rem;
      font-size: 0.65rem;
      padding: 0.4rem 0.75rem;
    }

    [dir="rtl"] .badge-container {
      right: auto;
      left: 0.75rem;
    }
  }

  /* Dark mode / Light mode compatibility */
  @media (prefers-color-scheme: light) {
    :root {
      --color-bg-dark: #f8fafc;
      --color-text-primary: #0f172a;
      --color-text-secondary: #475569;
    }

    .recommendation-header {
      background: linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(226, 232, 240, 0.8) 100%);
      border-bottom: 1px solid rgba(51, 65, 85, 0.1);
    }

    .recommendation-card {
      background: linear-gradient(135deg, rgba(241, 245, 249, 0.95) 0%, rgba(226, 232, 240, 0.9) 100%);
      border: 1px solid rgba(51, 65, 85, 0.15);
    }
  }
</style>
