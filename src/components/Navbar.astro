---

<nav class="nav-container">
  <div class="brand">SYSTEM CONTROLS</div>
  <div class="nav-links">
    <a href="/">Home</a>
    <a href="/vault">Vault Engine</a>
    <a href="/reviews">Reviews Log</a>
    <a href="/links">Affiliate Matrix</a>
  </div>
</nav>

<style>
  .nav-container {
    width: 100%;
    background: #161b22;
    border-bottom: 1px solid #30363d;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    gap: 1rem;
  }

  .brand {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    color: #c9d1d9;
    font-weight: 700;
    letter-spacing: 0.06em;
    font-size: 0.95rem;
  }

  .nav-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .nav-links a {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    color: #8b949e;
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
    transition: color 180ms ease, transform 180ms ease;
    font-size: 0.9rem;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: #58a6ff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms cubic-bezier(.2,.8,.2,1), opacity 160ms ease;
    opacity: 0.0;
  }

  .nav-links a:hover {
    color: #58a6ff;
    transform: translateY(-1px);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    opacity: 0.95;
  }
</style>
