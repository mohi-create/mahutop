// Reusable Premium Navigation Component
---
<nav class="system-navbar">
  <div class="nav-container">
    <!-- THE CHARISMATIC GEMSTONE BRANDING -->
    <a href="/" class="brand-gemstone">
      <span class="gem-sparkle">✦</span> MAHUTOP <span class="system-tag">// SOVEREIGN_CORE</span>
    </a>

    <!-- ALIGNED ROUTING LINKS -->
    <div class="nav-links">
      <a href="/" class="nav-item">HOME_BASE</a>
      <a href="/vault" class="nav-item functional-gate">SOVEREIGN VAULT</a>
      <a href="/links" class="nav-item">GRAND BAZAR // PRODUCTS</a>
      <a href="/reviews" class="nav-item">SYSTEM LOGS</a>
    </div>
  </div>
</nav>

<style>
  .system-navbar {
    background: #090d13;
    border-bottom: 2px solid #30363d;
    padding: 0 2rem;
    height: 70px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 9999;
  }
  .nav-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  /* THE PRICY CHARISMATIC GEMSTONE EFFECT */
  .brand-gemstone {
    font-family: 'Courier New', Courier, monospace;
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: 3px;
    text-decoration: none;
    color: #ffffff;
    background: linear-gradient(135deg, #58a6ff 0%, #ff79c6 50%, #50fa7b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 8px rgba(88, 166, 255, 0.4));
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .brand-gemstone:hover {
    filter: drop-shadow(0 0 15px rgba(255, 121, 198, 0.8));
    transform: scale(1.02);
  }
  .gem-sparkle {
    color: #ff79c6;
    -webkit-text-fill-color: initial;
    animation: pulse 2s infinite ease-in-out;
  }
  .system-tag {
    font-size: 0.7rem;
    color: #8b949e;
    -webkit-text-fill-color: initial;
    letter-spacing: 1px;
    margin-left: 5px;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  .nav-item {
    color: #c9d1d9;
    text-decoration: none;
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  .nav-item:hover {
    color: #58a6ff;
    border-color: #30363d;
    background: #161b22;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }
</style>
