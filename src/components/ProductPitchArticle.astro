---
interface Props {
  targetAudience: string;
  painPointSolved: string;
  whyBuyReasoning: string;
}

const {
  targetAudience = '',
  painPointSolved = '',
  whyBuyReasoning = '',
} = Astro.props as Props;
---

<section class="product-pitch-article">
  <div class="pitch-shell">
    <div class="pitch-grid">
      <article class="pitch-column">
        <span class="pitch-subtitle">WHO USUALLY ACQUIRES THIS CORE?</span>
        <h2 class="pitch-title">Target audience that turns browsers into buyers</h2>
        <p>{targetAudience}</p>
      </article>

      <article class="pitch-column">
        <span class="pitch-subtitle">THE EXACT PROBLEM ELIMINATED</span>
        <h2 class="pitch-title">The practical outcome that makes this purchase essential</h2>
        <p>{painPointSolved}</p>
      </article>

      <article class="pitch-column">
        <span class="pitch-subtitle">WHY DELAYING COST TRAPS CAPITAL</span>
        <h2 class="pitch-title">Why waiting now risks wasted time, money, and momentum</h2>
        <p>{whyBuyReasoning}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .product-pitch-article {
    width: 100%;
    margin: 2.5rem auto 0;
    padding: 1.5rem 1rem 2rem;
    color: #e8eef6;
    background: linear-gradient(180deg, rgba(6, 10, 20, 0.95) 0%, rgba(15, 23, 33, 0.96) 100%);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 24px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
  }

  .pitch-shell {
    max-width: 1320px;
    margin: 0 auto;
  }

  .pitch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .pitch-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 1.5rem;
    background: rgba(15, 23, 35, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 20px;
    backdrop-filter: blur(18px);
  }

  .pitch-subtitle {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: -0.25rem;
  }

  .pitch-title {
    font-size: clamp(1.15rem, 1.2vw, 1.45rem);
    line-height: 1.3;
    margin: 0;
    color: #f8fafc;
  }

  .pitch-column p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.85;
    color: #d8e2ef;
    letter-spacing: 0.01em;
  }

  @media (max-width: 980px) {
    .pitch-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .product-pitch-article {
      padding: 1rem;
    }

    .pitch-column {
      padding: 1.25rem;
    }

    .pitch-title {
      font-size: 1.15rem;
    }
  }
</style>