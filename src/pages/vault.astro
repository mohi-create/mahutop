---
import Navbar from '../components/Navbar.astro';
import VaultLayout from '../layouts/VaultLayout.astro';
---

<head>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
</head>

<VaultLayout title='Sovereign Secret Vault'>
  <Navbar />
  <style is:global>
    /* Premium Terminal Output Styling */
    .output-container {
      scrollbar-width: thin;
      scrollbar-color: rgba(16, 185, 129, 0.3) rgba(15, 23, 42, 0.5);
    }
    
    .output-container::-webkit-scrollbar {
      width: 6px;
    }
    
    .output-container::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.5);
      border-radius: 0.5rem;
    }
    
    .output-container::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.3);
      border-radius: 0.5rem;
    }
    
    .output-container::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.5);
    }

    /* Textarea custom scrollbar */
    textarea {
      scrollbar-width: thin;
      scrollbar-color: rgba(16, 185, 129, 0.2) rgba(15, 23, 42, 0.5);
    }
    
    textarea::-webkit-scrollbar {
      width: 6px;
    }
    
    textarea::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.5);
    }
    
    textarea::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.2);
      border-radius: 0.25rem;
    }
    
    textarea::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.4);
    }

    /* Button ripple effect on click */
    button {
      position: relative;
      overflow: hidden;
    }

    #clear-btn {
      border: 1px solid #30363d;
      color: #8b949e;
      background: rgba(15, 23, 42, 0.85);
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    #clear-btn:hover {
      background: rgba(51, 65, 85, 0.95);
      border-color: #58a6ff;
      color: #c9d1d9;
    }

    /* Output text animation */
    .output-container:not(:empty) {
      animation: fadeInContent 0.3s ease-out;
    }

    @keyframes fadeInContent {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    /* Control Panel Styling */
    .control-panel {
      border: 1px solid #30363d;
      background: #161b22;
      padding: 15px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 12px;
      color: #8b949e;
      font-family: 'Courier New', Courier, monospace;
      margin-bottom: 16px;
      border-radius: 6px;
    }

    .control-panel h3 {
      grid-column: 1 / -1;
      color: #58a6ff;
      font-size: 14px;
      font-weight: 600;
      margin: 0 0 8px 0;
      font-family: monospace;
    }

    #system-terminal-log {
      font-size: 0.85rem;
      background: #161b22;
      border-top: 1px solid #30363d;
      border-bottom: 1px solid #30363d;
      color: #c9d1d9;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
      padding: 0.85rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1rem 0 0;
      border-radius: 0.75rem;
    }

    .status-indicator {
      display: inline-flex;
      width: 0.85rem;
      height: 0.85rem;
      align-items: center;
      justify-content: center;
      color: #8b949e;
      text-shadow: 0 0 4px rgba(88, 166, 255, 0.2);
    }

    .status-indicator.success {
      color: #7ee787;
      text-shadow: 0 0 12px rgba(126, 231, 135, 0.75);
    }

    .status-indicator.alert {
      color: #f97316;
      text-shadow: 0 0 12px rgba(249, 115, 22, 0.6);
    }

    .status-indicator.error {
      color: #f85149;
      text-shadow: 0 0 12px rgba(248, 81, 73, 0.8);
    }

    .control-panel label {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-size: 13px;
      transition: color 0.2s ease;
    }

    .control-panel label:hover {
      color: #c9d1d9;
    }

    .control-panel input[type="checkbox"] {
      cursor: pointer;
      accent-color: #58a6ff;
    }

    /* Analytics Panel Styling */
    .analytics-panel {
      border: 1px solid #30363d;
      background: #0d1117;
      padding: 15px;
      border-radius: 6px;
      color: #8b949e;
      font-family: 'Courier New', Courier, monospace;
      margin-top: 16px;
    }

    .analytics-panel h3 {
      color: #58a6ff;
      font-size: 13px;
      font-weight: 600;
      margin: 0 0 12px 0;
      font-family: monospace;
    }

    .mono-list {
      font-family: 'Courier New', Courier, monospace;
      font-size: 12px;
      line-height: 1.6;
      color: #c9d1d9;
    }

    .mono-list .frequency-item {
      padding: 4px 8px;
      margin: 2px 0;
      background: rgba(88, 166, 255, 0.05);
      border-left: 2px solid #58a6ff;
    }
  </style>
  <div class='max-w-4xl mx-auto space-y-6 mt-4'>
    
    <!-- System Diagnostics Panel -->
    <div class='bg-slate-900 border border-emerald-500/30 p-6 rounded-xl shadow-2xl relative overflow-hidden'>
      <div class='absolute top-0 left-0 w-1 h-full bg-emerald-500'></div>
      <h2 class='text-xl font-mono font-bold text-emerald-400 mb-2'>System Diagnostics</h2>
      <p class='text-sm text-slate-400 font-mono'>
        Core engine online. Ready to normalize targeted text strings and map structures.
      </p>
    </div>

    <!-- UI Interaction Module Workspace -->
    <div class='bg-slate-900 border border-slate-800 p-6 rounded-xl shadow-xl'>
      <h3 class='text-md font-mono font-semibold text-slate-300 mb-4'>
        🧬 Text Normalization Module
      </h3>
      
      <div class='space-y-4'>
        <!-- Input Section -->
        <div>
          <label class='block text-xs font-mono text-emerald-500/80 uppercase tracking-widest font-semibold mb-3'>
            Raw Input Text / Key-Phrases
          </label>
          <input type='file' id='bulk-file-input' accept='.txt,.pdf,.docx' style='display: none;' />
          <div
            id='drop-zone'
            class='mt-2 mb-4 rounded-xl border-2 border-dashed border-[#30363d] bg-slate-950/60 text-slate-400 text-sm font-mono leading-relaxed px-4 py-6 cursor-pointer transition-colors duration-200'
          >
            Drag & Drop an Arabic .txt, .pdf, or .docx file here or Click to Browse
          </div>

          <!-- Normalization Control Panel -->
          <div class="control-panel">
            <h3>Engine Rule Settings</h3>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="toggle-alif" checked class="font-mono text-emerald-500" />
              <label for="toggle-alif" class="text-sm text-gray-300">Normalize Alif (أ، إ، آ -> ا)</label>
            </div>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="toggle-ya" checked class="font-mono text-emerald-500" />
              <label for="toggle-ya" class="text-sm text-gray-300">Normalize Ya (ي -> ى)</label>
            </div>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="toggle-ta" checked class="font-mono text-emerald-500" />
              <label for="toggle-ta" class="text-sm text-gray-300">Normalize Ta Marbuta (ة -> ه)</label>
            </div>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="toggle-tashkeel" checked class="font-mono text-emerald-500" />
              <label for="toggle-tashkeel" class="text-sm text-gray-300">Strip Diacritics (Tashkeel)</label>
            </div>
          </div>

          <textarea 
            id='input-textarea'
            rows='6' 
            class='w-full bg-slate-950 border border-slate-800 rounded-lg p-4 font-mono text-sm text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500 focus:shadow-lg focus:shadow-emerald-500/20 transition-all duration-200'
            placeholder='Enter raw text string lines to normalize...'
          ></textarea>
        </div>

        <!-- Control Panel -->
        <div class='flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-end pt-2'>
          <button 
            id='clear-terminal' 
            class='bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-slate-100 px-4 py-2.5 rounded-lg font-mono text-xs font-semibold uppercase tracking-wider transition-all duration-200 border border-slate-700 hover:border-slate-600 active:scale-95'
          >
            Clear Terminal
          </button>
          <button 
            id='normalize-button' 
            class='bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-slate-950 font-bold px-6 py-2.5 rounded-lg font-mono text-xs uppercase tracking-wider transition-all duration-200 shadow-lg shadow-emerald-900/30 hover:shadow-emerald-500/50 border border-emerald-500/50 hover:border-emerald-400 active:scale-95'
          >
            Execute Normalization
          </button>
          <button
            type='button'
            id='clear-btn'
            class='bg-slate-900/80 border border-slate-700 text-slate-400 hover:bg-slate-800 hover:border-slate-600 hover:text-slate-100 px-4 py-2.5 rounded-lg font-mono text-xs font-semibold uppercase tracking-wider transition-all duration-200 active:scale-95'
          >
            Clear Workspace
          </button>
        </div>

        <div id='system-terminal-log'>
          <span class='status-indicator alert'>●</span>
          <span id='terminal-message'>SYSTEM STANDBY // READY TO PROCESS ENGINE LOGS</span>
        </div>

        <!-- Output Terminal Container -->
        <div id='output-results' class='output-container mt-6 p-5 rounded-lg border border-emerald-500/30 bg-slate-950 text-slate-200 font-mono text-sm min-h-[8rem] max-h-[16rem] overflow-y-auto shadow-inner ring-1 ring-slate-800/50'>
          <!-- Phase 2 engine output goes here -->
        </div>

        <!-- Analytics Panel: Phrase Frequency Analysis -->
        <div class="analytics-panel">
          <h3>Subsystem Diagnostics // Phrase Frequency Analysis</h3>
          <div id="frequency-results" class="mono-list">No data analyzed yet.</div>
        </div>

        <!-- Phase 3: Statistics Dashboard -->
        <div class='mt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3'>
          <div id='char-stats' class='text-sm font-mono text-slate-400'>Input: 0 chars | Output: 0 chars</div>

          <div class='flex items-center gap-3'>
            <div id='rule-badges' class='flex gap-2 items-center'>
              <span id='badge-alif' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Alif Fixed</span>
              <span id='badge-ya' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Ya Normalized</span>
              <span id='badge-ta' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Ta Marbuta Cleaned</span>
              <span id='badge-diacritics' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Diacritics Stripped</span>
            </div>

            <button id='copy-button' class='ml-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-slate-100 px-3 py-1.5 rounded-lg font-mono text-xs font-semibold transition-all duration-150 border border-slate-700'>Copy</button>
            <button id='download-file-btn' class='ml-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-slate-100 px-3 py-1.5 rounded-lg font-mono text-xs font-semibold transition-all duration-150 border border-slate-700'>Download Cleaned File</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</VaultLayout>

<script is:inline>
  // Self-contained secure access validation engine
  document.addEventListener('DOMContentLoaded', () => {
    const MASTER_CONFIG = {
      passphrase: "mahutop_sovereign_2026",
      sessionKey: "mahutop_secure_session"
    };

    if (sessionStorage.getItem(MASTER_CONFIG.sessionKey) !== 'true') {
      const entryKey = prompt("ENTER CRITICAL CORE AUTHORIZATION PASSWORD / أدخل كلمة المرور:");
      
      if (entryKey === MASTER_CONFIG.passphrase) {
        sessionStorage.setItem(MASTER_CONFIG.sessionKey, 'true');
        alert("ACCESS GRANTED // تم السماح بالدخول");
      } else {
        alert("ACCESS DENIED // تم رفض الدخول");
        window.location.href = "/";
      }
    }
  });
</script>

<style>
  /* Cyber-Vault Theme Overrides */
  :global(body) {
    background-color: #0d1117 !important;
    color: #c9d1d9 !important;
    font-family: 'Courier New', Courier, monospace !important;
  }

  textarea {
    background-color: #161b22 !important;
    color: #58a6ff !important;
    border: 1px solid #30363d !important;
    border-radius: 4px;
    padding: 12px;
    font-family: monospace;
  }

  textarea:focus {
    outline: none !important;
    border-color: #58a6ff !important;
    box-shadow: 0 0 8px rgba(88, 166, 255, 0.3);
  }

  button {
    background-color: #21262d !important;
    color: #c9d1d9 !important;
    border: 1px solid #30363d !important;
    padding: 8px 16px;
    cursor: pointer;
    font-weight: bold;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  button:hover {
    background-color: #30363d !important;
    border-color: #8b949e !important;
  }

  #drop-zone {
    border: 2px dashed #30363d;
    color: #8b949e;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    background-color: #0d1117;
    border-radius: 1rem;
    padding: 1.25rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  #drop-zone:hover,
  #drop-zone.dragover {
    border-color: #58a6ff;
    box-shadow: 0 0 0 1px rgba(88, 166, 255, 0.18);
  }

  /* Dashboard Badges Styling */
  .badge, [data-badge] {
    display: inline-block;
    padding: 4px 8px;
    margin: 4px;
    border-radius: 3px;
    font-size: 0.85rem;
    background-color: #21262d;
    color: #484f58;
    border: 1px solid #30363d;
    transition: all 0.3s ease;
  }

  /* Glowing State for Active Rules */
  .badge.active, [data-badge].active {
    background-color: rgba(56, 139, 253, 0.15) !important;
    color: #58a6ff !important;
    border-color: #58a6ff !important;
    text-shadow: 0 0 4px rgba(88, 166, 255, 0.6);
  }

  /* Output Screen */
  .output-container, #output-results {
    background-color: #161b22 !important;
    border-left: 4px solid #388bfd !important;
    padding: 12px;
    font-family: monospace;
    color: #79c0ff;
  }

  #download-file-btn {
    color: #2ea44f !important;
    border-color: #238636 !important;
    background-color: rgba(46, 164, 79, 0.08) !important;
  }

  #download-file-btn:hover {
    background-color: rgba(46, 164, 79, 0.16) !important;
  }

  #download-file-btn:disabled {
    opacity: 0.5 !important;
    cursor: not-allowed !important;
  }
</style>