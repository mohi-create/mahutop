---
import VaultLayout from '../layouts/VaultLayout.astro';
---

<VaultLayout title='Sovereign Secret Vault'>
  <style is:global>
    /* Premium Terminal Output Styling */
    .output-container {
      scrollbar-width: thin;
      scrollbar-color: rgba(16, 185, 129, 0.3) rgba(15, 23, 42, 0.5);
    }
    
    .output-container::-webkit-scrollbar {
      width: 6px;
    }
    
    .output-container::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.5);
      border-radius: 0.5rem;
    }
    
    .output-container::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.3);
      border-radius: 0.5rem;
    }
    
    .output-container::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.5);
    }

    /* Textarea custom scrollbar */
    textarea {
      scrollbar-width: thin;
      scrollbar-color: rgba(16, 185, 129, 0.2) rgba(15, 23, 42, 0.5);
    }
    
    textarea::-webkit-scrollbar {
      width: 6px;
    }
    
    textarea::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.5);
    }
    
    textarea::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.2);
      border-radius: 0.25rem;
    }
    
    textarea::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.4);
    }

    /* Button ripple effect on click */
    button {
      position: relative;
      overflow: hidden;
    }

    /* Output text animation */
    .output-container:not(:empty) {
      animation: fadeInContent 0.3s ease-out;
    }

    @keyframes fadeInContent {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  </style>
  <div class='max-w-4xl mx-auto space-y-6 mt-4'>
    
    <!-- System Diagnostics Panel -->
    <div class='bg-slate-900 border border-emerald-500/30 p-6 rounded-xl shadow-2xl relative overflow-hidden'>
      <div class='absolute top-0 left-0 w-1 h-full bg-emerald-500'></div>
      <h2 class='text-xl font-mono font-bold text-emerald-400 mb-2'>System Diagnostics</h2>
      <p class='text-sm text-slate-400 font-mono'>
        Core engine online. Ready to normalize targeted text strings and map structures.
      </p>
    </div>

    <!-- UI Interaction Module Workspace -->
    <div class='bg-slate-900 border border-slate-800 p-6 rounded-xl shadow-xl'>
      <h3 class='text-md font-mono font-semibold text-slate-300 mb-4'>
        🧬 Text Normalization Module
      </h3>
      
      <div class='space-y-4'>
        <!-- Input Section -->
        <div>
          <label class='block text-xs font-mono text-emerald-500/80 uppercase tracking-widest font-semibold mb-3'>
            Raw Input Text / Key-Phrases
          </label>
          <textarea 
            id='input-textarea'
            rows='6' 
            class='w-full bg-slate-950 border border-slate-800 rounded-lg p-4 font-mono text-sm text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500 focus:shadow-lg focus:shadow-emerald-500/20 transition-all duration-200'
            placeholder='Enter raw text string lines to normalize...'
          ></textarea>
        </div>

        <!-- Control Panel -->
        <div class='flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-end pt-2'>
          <button 
            id='clear-terminal' 
            class='bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-slate-100 px-4 py-2.5 rounded-lg font-mono text-xs font-semibold uppercase tracking-wider transition-all duration-200 border border-slate-700 hover:border-slate-600 active:scale-95'
          >
            Clear Terminal
          </button>
          <button 
            id='normalize-button' 
            class='bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-slate-950 font-bold px-6 py-2.5 rounded-lg font-mono text-xs uppercase tracking-wider transition-all duration-200 shadow-lg shadow-emerald-900/30 hover:shadow-emerald-500/50 border border-emerald-500/50 hover:border-emerald-400 active:scale-95'
          >
            Execute Normalization
          </button>
        </div>

        <!-- Output Terminal Container -->
        <div id='output-results' class='output-container mt-6 p-5 rounded-lg border border-emerald-500/30 bg-slate-950 text-slate-200 font-mono text-sm min-h-[8rem] max-h-[16rem] overflow-y-auto shadow-inner ring-1 ring-slate-800/50'>
          <!-- Phase 2 engine output goes here -->
        </div>

        <!-- Phase 3: Statistics Dashboard -->
        <div class='mt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3'>
          <div id='char-stats' class='text-sm font-mono text-slate-400'>Input: 0 chars | Output: 0 chars</div>

          <div class='flex items-center gap-3'>
            <div id='rule-badges' class='flex gap-2 items-center'>
              <span id='badge-alif' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Alif Fixed</span>
              <span id='badge-ya' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Ya Normalized</span>
              <span id='badge-ta' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Ta Marbuta Cleaned</span>
              <span id='badge-diacritics' class='px-2 py-1 rounded text-xs font-mono bg-slate-800/40 text-slate-500 opacity-50'>Diacritics Stripped</span>
            </div>

            <button id='copy-button' class='ml-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-slate-100 px-3 py-1.5 rounded-lg font-mono text-xs font-semibold transition-all duration-150 border border-slate-700'>Copy</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</VaultLayout>

<script>
  // @ts-nocheck

  document.addEventListener('DOMContentLoaded', () => {
    /** @type {HTMLTextAreaElement | null} */
    const inputTextArea = document.querySelector('textarea');
    /** @type {HTMLDivElement | null} */
    const outputContainer = document.querySelector('#output-results') || document.querySelector('.output-container');

    /** @type {HTMLDivElement | null} */
    const charStats = document.getElementById('char-stats');
    /** @type {HTMLButtonElement | null} */
    const copyButton = document.getElementById('copy-button');
    /** @type {HTMLElement | null} */
    const badgeAlif = document.getElementById('badge-alif');
    /** @type {HTMLElement | null} */
    const badgeYa = document.getElementById('badge-ya');
    /** @type {HTMLElement | null} */
    const badgeTa = document.getElementById('badge-ta');
    /** @type {HTMLElement | null} */
    const badgeDiacritics = document.getElementById('badge-diacritics');

    /** @type {HTMLButtonElement | null} */
    const normalizeButton = /** @type {HTMLButtonElement | null} */ (document.getElementById('normalize-button'));
    /** @type {HTMLButtonElement | null} */
    const clearButton = /** @type {HTMLButtonElement | null} */ (document.getElementById('clear-terminal'));

    /**
     * Update a badge element's active state.
     * @param {HTMLElement | null} el
     * @param {boolean} active
     */
    function updateBadge(el, active) {
      if (!el) return;
      if (active) {
        el.classList.remove('opacity-50','bg-slate-800/40','text-slate-500');
        el.classList.add('bg-emerald-600','text-slate-950','opacity-100');
      } else {
        el.classList.add('opacity-50','bg-slate-800/40','text-slate-500');
        el.classList.remove('bg-emerald-600','text-slate-950','opacity-100');
      }
    }

    /**
     * Reset UI to default state.
     */
    function resetUI() {
      if (inputTextArea) inputTextArea.value = '';
      if (outputContainer) outputContainer.textContent = 'Your normalized text will appear here...';
      if (charStats) charStats.textContent = 'Input: 0 chars | Output: 0 chars';
      updateBadge(badgeAlif, false);
      updateBadge(badgeYa, false);
      updateBadge(badgeTa, false);
      updateBadge(badgeDiacritics, false);
    }

    // Initialize UI
    resetUI();

    if (normalizeButton && inputTextArea && outputContainer) {
      normalizeButton.addEventListener('click', function () {
        var raw = inputTextArea.value || '';

        var hasAlif = /[أإآ]/.test(raw);
        var hasYa = /ى/.test(raw);
        var hasTa = /ة/.test(raw);
        var hasDiacritics = /[\u064B-\u0652]/.test(raw);

        var text = raw.replace(/[أإآ]/g, 'ا');
        text = text.replace(/ى/g, 'ي');
        text = text.replace(/ة/g, 'ه');
        text = text.replace(/[\u064B-\u0652]/g, '');
        text = text.replace(/ +/g, ' ').replace(/\n\s*\n+/g, '\n').trim();

        outputContainer.textContent = text || 'Your normalized text will appear here...';

        updateBadge(badgeAlif, hasAlif);
        updateBadge(badgeYa, hasYa);
        updateBadge(badgeTa, hasTa);
        updateBadge(badgeDiacritics, hasDiacritics);

        var inputLen = raw.length;
        var outputLen = text.length;
        if (charStats) charStats.textContent = "Input: " + inputLen + " chars | Output: " + outputLen + " chars";
      });
    }

    if (copyButton) {
      copyButton.addEventListener('click', function () {
        var text = outputContainer ? outputContainer.textContent || '' : '';
        if (!text) return;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text);
          } else {
            var ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          copyButton.textContent = 'Copied';
          setTimeout(function () { copyButton.textContent = 'Copy'; }, 1200);
        } catch (e) {
          console.error('Copy failed', e);
        }
      });
    }

    if (clearButton) {
      clearButton.addEventListener('click', function () {
        resetUI();
      });
    }
  });
</script>

<style>
  /* Cyber-Vault Theme Overrides */
  :global(body) {
    background-color: #0d1117 !important;
    color: #c9d1d9 !important;
    font-family: 'Courier New', Courier, monospace !important;
  }

  textarea {
    background-color: #161b22 !important;
    color: #58a6ff !important;
    border: 1px solid #30363d !important;
    border-radius: 4px;
    padding: 12px;
    font-family: monospace;
  }

  textarea:focus {
    outline: none !important;
    border-color: #58a6ff !important;
    box-shadow: 0 0 8px rgba(88, 166, 255, 0.3);
  }

  button {
    background-color: #21262d !important;
    color: #c9d1d9 !important;
    border: 1px solid #30363d !important;
    padding: 8px 16px;
    cursor: pointer;
    font-weight: bold;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  button:hover {
    background-color: #30363d !important;
    border-color: #8b949e !important;
  }

  /* Dashboard Badges Styling */
  .badge, [data-badge] {
    display: inline-block;
    padding: 4px 8px;
    margin: 4px;
    border-radius: 3px;
    font-size: 0.85rem;
    background-color: #21262d;
    color: #484f58;
    border: 1px solid #30363d;
    transition: all 0.3s ease;
  }

  /* Glowing State for Active Rules */
  .badge.active, [data-badge].active {
    background-color: rgba(56, 139, 253, 0.15) !important;
    color: #58a6ff !important;
    border-color: #58a6ff !important;
    text-shadow: 0 0 4px rgba(88, 166, 255, 0.6);
  }

  /* Output Screen */
  .output-container, #output-results {
    background-color: #161b22 !important;
    border-left: 4px solid #388bfd !important;
    padding: 12px;
    font-family: monospace;
    color: #79c0ff;
  }
</style>