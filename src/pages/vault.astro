---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Sovereign Vault">
  <div class="system-controls-wrapper font-mono">
    <h1 class="text-xl tracking-wider text-white mb-6">
      <span data-key="vault">SOVEREIGN // VAULT_CORE</span>
    </h1>

    <div class="bg-slate-900 border border-slate-800 p-6 rounded-md">
      <h2 class="text-emerald-400 text-lg mb-4" data-key="logs">System Diagnostics</h2>
      <p class="text-gray-400 text-sm mb-6" data-key="reviewsSub">
        Core engine online. Ready to normalize targeted text strings and map structures.
      </p>

      </div>
  </div>
</MainLayout>

<script>
  // Safe authentication wrapper executed after layout hydration completes
  document.addEventListener('DOMContentLoaded', () => {
    const MASTER_PASSPHRASE = "mahutop_sovereign_2026";
    const SESSION_FLAG = "mahutop_secure_session";

    if (sessionStorage.getItem(SESSION_FLAG) !== 'true') {
      const userInput = prompt("ENTER CRITICAL CORE AUTHORIZATION PASSWORD / أدخل كلمة المرور:");
      
      if (userInput === MASTER_PASSPHRASE) {
        sessionStorage.setItem(SESSION_FLAG, 'true');
        alert("ACCESS GRANTED // تم السماح بالدخول");
      } else {
        alert("ACCESS DENIED // SECURITY VIOLATION");
        window.location.href = "/";
      }
    }
  });
</script>
