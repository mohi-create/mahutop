---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="SOVEREIGN SYSTEM CORE">
  <Navbar />

  <main class="dashboard-hub">
    <section class="dashboard-intro">
      <h1>SOVEREIGN SYSTEM CORE // MAIN_MENU</h1>
      <div class="diagnostics-card">
        <p>SYSTEM OPERATIONAL // LATENCY 0ms // MODULES FULLY DEPLOYED</p>
      </div>
    </section>

    <section class="launch-grid">
      <a class="launch-card" href="/vault">
        <h2>LAUNCH VAULT ENGINE</h2>
        <p>Execute Arabic character normalization, text diacritic stripping, and bulk text, PDF, or Word document processing rules.</p>
      </a>

      <a class="launch-card" href="/reviews">
        <h2>ACCESS REVIEWS DATABASE</h2>
        <p>Browse encrypted local file logs, development audits, and markdown system documentation.</p>
      </a>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #0d1117;
    color: #c9d1d9;
    font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace;
  }

  .dashboard-hub {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .dashboard-intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dashboard-intro h1 {
    font-size: clamp(2rem, 3vw, 3.5rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
    color: #c9d1d9;
  }

  .diagnostics-card {
    border: 1px solid #30363d;
    padding: 1.5rem 1.75rem;
    border-radius: 14px;
    background: rgba(17, 24, 39, 0.75);
    box-shadow: 0 0 0 1px rgba(56, 139, 253, 0.06);
  }

  .diagnostics-card p {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .launch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .launch-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    border: 1px solid #30363d;
    padding: 1.75rem;
    border-radius: 16px;
    background: rgba(12, 17, 23, 0.96);
    transition: transform 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    color: #c9d1d9;
  }

  .launch-card h2 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .launch-card p {
    margin: 0;
    line-height: 1.75;
    color: #8b949e;
  }

  .launch-card:hover,
  .launch-card:focus-visible {
    transform: translateY(-2px);
    border-color: #58a6ff;
    box-shadow: 0 0 35px rgba(88, 166, 255, 0.25);
    color: #58a6ff;
  }

  .launch-card:hover h2,
  .launch-card:focus-visible h2 {
    color: #58a6ff;
  }

  .launch-card:hover p,
  .launch-card:focus-visible p {
    color: #c9d1d9;
  }
</style>
