---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SOVEREIGN SYSTEM CORE">
  <main class="dashboard-hub">
    <section class="dashboard-intro">
      <h1 data-i18n-key="homeTitle">SOVEREIGN SYSTEM CORE // MAIN_MENU</h1>
      <div class="diagnostics-card">
        <p data-i18n-key="systemStatus">SYSTEM OPERATIONAL // LATENCY 0ms // MODULES FULLY DEPLOYED</p>
      </div>
    </section>

    <section class="launch-grid">
      <a class="launch-card" href="/vault">
        <h2 data-i18n-key="launchVaultBtn">LAUNCH VAULT ENGINE</h2>
        <p data-i18n-key="launchVaultDesc">Execute Arabic character normalization, text diacritic stripping, and bulk text, PDF, or Word document processing rules.</p>
      </a>

      <a class="launch-card" href="/reviews">
        <h2 data-i18n-key="accessReviewsBtn">ACCESS REVIEWS DATABASE</h2>
        <p data-i18n-key="accessReviewsDesc">Browse encrypted local file logs, development audits, and markdown system documentation.</p>
      </a>
    </section>
  </main>
</Layout>

<style>
  .dashboard-hub { max-width: 1200px; margin: 0 auto; padding: 1rem 0 3rem; display: flex; flex-direction: column; gap: 2.5rem; box-sizing: border-box; }
  .dashboard-intro { display: flex; flex-direction: column; gap: 1.5rem; }
  .dashboard-intro h1 { font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: 0.15em; text-transform: uppercase; margin: 0; color: #e6eef6; }
  .diagnostics-card { border: 1px solid rgba(56, 189, 248, 0.15); padding: 1.5rem 1.75rem; border-radius: 14px; background: rgba(9, 12, 18, 0.8); box-shadow: 0 0 30px rgba(56, 189, 248, 0.03); }
  .diagnostics-card p { margin: 0; font-size: 0.9rem; letter-spacing: 0.12em; color: #6ee7b7; }
  .launch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .launch-card { display: flex; flex-direction: column; gap: 1rem; text-decoration: none; border: 1px solid rgba(255, 255, 255, 0.08); padding: 1.75rem; border-radius: 16px; background: rgba(9, 12, 18, 0.95); transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease; color: #e6eef6; }
  .launch-card h2 { margin: 0; font-size: 1.1rem; letter-spacing: 0.1em; text-transform: uppercase; color: #38bdf8; }
  .launch-card p { margin: 0; line-height: 1.7; color: #94a3b8; font-size: 0.95rem; }
  .launch-card:hover { transform: translateY(-3px); border-color: #38bdf8; box-shadow: 0 12px 40px rgba(56, 189, 248, 0.15); }
</style>