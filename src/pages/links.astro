---
import Layout from '../layouts/Layout.astro';
import ProductComparer from '../components/ProductComparer.astro';
import RecommendationHeader from '../components/RecommendationHeader.astro';
import { products, recommendations } from '../data/products';

const productSections = [
  {
    key: 'electronics',
    title: '01 // ELECTRONICS & TECHNOLOGY [PERFORMANCE BENCHMARKS]',
    items: products.filter((item) => item.category === 'Electronics'),
  },
  {
    key: 'home',
    title: '02 // HOME & KITCHEN [BUYING GUIDES & SETUPS]',
    items: products.filter((item) => item.category === 'Home'),
  },
  {
    key: 'fashion',
    title: '03 // FASHION & ACCESSORIES [STYLE RECOMMENDATIONS]',
    items: products.filter((item) => item.category === 'Fashion'),
  },
  {
    key: 'health',
    title: '04 // HEALTH & PERSONAL CARE [EXPERT ROUTINES]',
    items: products.filter((item) => item.category === 'Health'),
  },
];
---
<Layout title="Grand Bazaar Products">

  <div class="store-shell">
    <RecommendationHeader items={recommendations} />

    <section class="section-intro">
      <header class="store-header mt-4">
        <h1 data-i18n-key="bazaarTitle">Affiliate Matrix</h1>
        <p class="lead" data-i18n-key="bazaarSub">Curated premium storefront — time-limited offers auto-expire.</p>
      </header>
    </section>

    <section class="section-comparer">
      <h2 class="section-heading" data-i18n-key="comparerTitle">Compare Top Products</h2>
      <p class="section-copy" data-i18n-key="comparerDesc">Select up to three products to compare pricing, categories, and feature details in a single side-by-side view.</p>
      <ProductComparer products={products} maxComparisons={3} />
    </section>

    {productSections.map((section) => (
      <section class={`section-${section.key}`}>
        <h2 class="sec-title" data-i18n-key={`${section.key}Title`}>{section.title}</h2>
        <div class="cards-grid">
          {section.items.map((product) => (
            <article class="product-card">
              <div class="card-copy">
                <h3>{product.name}</h3>
                <p>{product.description}</p>
              </div>
              <div class="price-box">
                {product.priceOld ? <span class="old-price">{product.priceOld}</span> : null}
                <span class="new-price">{product.priceNew}</span>
              </div>
              <a href={product.affiliateLink} target="_blank" rel="noopener noreferrer" class="product-cta" data-i18n-key="visitAffiliate">Visit Affiliate</a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="section-ai">
      <div class="assistant-panel">
        <div class="assistant-header">
          <div>
            <h2 class="sec-title" data-i18n-key="aiAssistantTitle">AI Article Assistant</h2>
            <p class="assistant-copy" data-i18n-key="aiAssistantDesc">Draft a product summary or promotional article instantly using a prompt that fits your affiliate storefront.</p>
          </div>
        </div>

        <div class="assistant-body">
          <label for="ai-prompt" data-i18n-key="aiPromptLabel">Describe the content you want</label>
          <input id="ai-prompt" type="text" data-i18n-placeholder="aiPromptPlaceholder" placeholder="Create a product launch article for a premium tech rig" autocomplete="off" />
          <button id="ai-generate" type="button" data-i18n-key="aiGenerateBtn">Generate AI Article</button>

          <div id="ai-output" class="assistant-output" aria-live="polite">
            <p class="assistant-empty" data-i18n-key="aiEmptyState">Type a prompt and click Generate to create a product article summary.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  :root {
    --bg: #06070a;
    --muted: #9aa4af;
    --accent-cyan: #00f0ff;
    --accent-green: #4ade80;
    --accent-peach: #fbbf24;
    --card-bg: rgba(7, 11, 19, 0.9);
    --border: rgba(148, 163, 184, 0.12);
  }

  .store-shell { max-width: 1150px; margin: 0 auto; padding: 1.5rem 1.25rem 5rem; display: flex; flex-direction: column; gap: 2.5rem; }
  .store-header h1 { margin: 0; font-size: 2rem; letter-spacing: 0.12em; text-transform: uppercase; color: #f8fafc; }
  .lead { color: var(--muted); margin: 0.5rem 0 0; max-width: 680px; }

  .section-intro { padding-top: 1rem; }
  .section-comparer { padding: 2rem 0 1rem; border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .section-heading { margin: 0 0 0.5rem; font-size: 1.15rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-cyan); }
  .section-copy { margin: 0 0 1.5rem; color: var(--muted); max-width: 720px; }

  .section-electronics, .section-home, .section-fashion, .section-health { padding: 1.5rem 0; }
  .cards-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .product-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 18px; padding: 1.5rem; display: grid; gap: 1rem; }
  .card-copy h3 { margin: 0 0 0.5rem; font-size: 1.05rem; color: #f8fafc; }
  .card-copy p { margin: 0; color: #cbd5e1; line-height: 1.7; }

  .price-box { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .old-price { color: #94a3b8; text-decoration: line-through; font-size: 0.95rem; }
  .new-price { color: #ffffff; font-size: 1.1rem; font-weight: 700; }

  .product-cta { display: inline-flex; align-items: center; justify-content: center; width: fit-content; padding: 0.85rem 1.25rem; border-radius: 999px; background: linear-gradient(90deg, #00d2ff, #3b82f6); color: #030712; text-decoration: none; font-weight: 700; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .product-cta:hover { transform: translateY(-1px); box-shadow: 0 14px 35px rgba(56, 189, 248, 0.18); }

  .section-ai { padding: 2rem 0; }
  .assistant-panel { display: grid; gap: 1.2rem; }
  .assistant-header { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
  .assistant-copy { color: #b8d7ff; max-width: 760px; margin: 0; font-size: 0.95rem; line-height: 1.6; }
  .assistant-body { display: grid; gap: 1rem; }
  .assistant-body label { font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.18em; color: #6ee7b7; }

  #ai-prompt { width: 100%; border: 1px solid rgba(255,255,255,0.08); background: rgba(9, 12, 18, 0.95); color: #e2e8f0; padding: 1rem 1.1rem; border-radius: 14px; outline: none; }
  #ai-generate { align-self: flex-start; padding: 0.95rem 1.4rem; border-radius: 14px; background: linear-gradient(90deg,#38bdf8,#0ea5e9); color: #030712; font-weight: 700; border: none; cursor: pointer; }
  .assistant-output { min-height: 240px; border: 1px solid rgba(255,255,255,0.08); background: rgba(1,5,12,0.92); border-radius: 16px; padding: 1.25rem; display: grid; gap: 1rem; color: #dbeafe; }
  .assistant-empty { color: #94a3b8; font-size: 0.96rem; line-height: 1.7; margin: 0; }
  .generated-article { margin: 0; white-space: pre-wrap; line-height: 1.75; }

  @media (max-width: 720px) {
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const aiPrompt = document.getElementById('ai-prompt');
  const aiButton = document.getElementById('ai-generate');
  const aiOutput = document.getElementById('ai-output');

  const getLang = () => {
    return localStorage.getItem('mahutop-lang') === 'ar' ? 'ar' : 'en';
  };

  const articleMessages = {
    en: 'Please enter a prompt to generate a compelling product article summary.',
    ar: 'يرجى إدخال وصف لتوليد ملخص مقال تسويقي جذاب للمنتج.',
  };

  const articleTemplates = {
    en: (value: string) => `Product Article Preview:\n\n${value} is positioned as a market-leading affiliate story that emphasizes premium quality, conversion-ready messaging, and a strong purchase rationale. This content highlights benefits, performance, and lifestyle appeal while keeping links and action clear for high-value buyers.\n\nKey takeaways:\n• Focus on what makes the product special for modern creators and collectors.\n• Reinforce affiliate value with practical use and outcome-driven storytelling.\n• Keep the tone bold, direct, and trusted for premium purchase decisions.`,
    ar: (value: string) => `معاينة مقال المنتج:\n\nيُقدَّم ${value} كقصة تسويق بالعمولة رائدة في السوق، تركز على الجودة العالية، والرسائل الموجهة للتحويل، والأساس المنطقي القوي للشراء. يبرز هذا المحتوى المزايا، والأداء، والجاذبية الحياتية مع إبقاء الروابط والإجراءات واضحة للمشترين ذوي القيمة العالية.\n\nأبرز النقاط:\n• التركيز على ما يجعل المنتج مميزًا للمبدعين وهواة الجمع المعاصرين.\n• تعزيز قيمة التسويق بالعمولة من خلال الاستخدام العملي والسرد القصصي القائم على النتائج.\n• الحفاظ على أسلوب جريء ومباشر وموثوق لقرارات الشراء المميزة.`,
  };

  const createArticle = (prompt: string) => {
    const value = (prompt || '').trim();
    const lang = getLang();
    if (!value) return articleMessages[lang];
    return articleTemplates[lang](value);
  };

  if (aiButton && aiPrompt && aiOutput) {
    aiButton.addEventListener('click', () => {
      const article = createArticle((aiPrompt as HTMLInputElement).value);
      aiOutput.innerHTML = '';
      const paragraph = document.createElement('p');
      paragraph.className = 'generated-article';
      paragraph.textContent = article;
      aiOutput.appendChild(paragraph);
    });
  }
</script>