---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Affiliate Matrix">
  <main class="store-shell">
    <header class="store-header">
      <h1>Affiliate Matrix</h1>
      <p class="lead">Curated premium storefront — time-limited offers auto-expire.</p>
    </header>

    <!-- SECTION 1: ELECTRONICS (Cyber Grid Style) -->
    <section class="section-electronics">
      <h2 class="sec-title">01 // ELECTRONICS & TECHNOLOGY [PERFORMANCE BENCHMARKS]</h2>
      <div class="cyber-grid">
        <div class="prod-card deal-card" data-expires="2026-07-01T00:00:00" data-id="p1">
          <div class="timer-badge">OFFER ENDS: <span class="countdown">--:--:--</span></div>
          <h3>Pro Compute Core Rig</h3>
          <p class="angle">Benchmark: Optimized for local Dolphin3 & LLM execution.</p>
          <div class="price-tag"><span class="old-price">$1,499</span> <span class="new-price">$1,299</span></div>
          <a href="#" target="_blank" class="buy-btn">BUY VIA AFFILIATE</a>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HOME & KITCHEN (Minimalist Clean Row Style) -->
    <section class="section-home">
      <h2 class="sec-title">02 // HOME & KITCHEN [BUYING GUIDES & SETUPS]</h2>
      <div class="minimal-rows">
        <div class="prod-row" data-id="p2">
          <h3>Ergonomic Workspace Command Desk</h3>
          <p class="angle">Setup: Perfect minimalist cable-managed layout.</p>
          <div class="price-tag">$349</div>
          <a href="#" target="_blank" class="buy-link">View Deal →</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3: FASHION & ACCESSORIES (Sleek Border Card Style) -->
    <section class="section-fashion">
      <h2 class="sec-title">03 // FASHION & ACCESSORIES [STYLE RECOMMENDATIONS]</h2>
      <div class="fashion-cards">
        <div class="fashion-card deal-card" data-expires="2026-06-15T12:00:00" data-id="p3">
          <div class="timer-badge">LIMITED LOG: <span class="countdown">--:--:--</span></div>
          <h3>Tactical Cyber-Shell Parka</h3>
          <p class="angle">Style: Matte-black weatherized utility outer shell.</p>
          <div class="price-tag"><span class="old-price">$180</span> <span class="new-price">$120</span></div>
          <a href="#" target="_blank" class="fashion-btn">SECURE ITEM</a>
        </div>
      </div>
    </section>

    <!-- SECTION 4: HEALTH & CARE (Bio-Green Terminal Column Style) -->
    <section class="section-health">
      <h2 class="sec-title">04 // HEALTH & PERSONAL CARE [EXPERT ROUTINES]</h2>
      <div class="health-columns">
        <div class="health-col" data-id="p4">
          <h3>Smart Nootropic Focus Stacks</h3>
          <p class="angle">Routine: Morning execution matrix for deep focus work.</p>
          <div class="price-tag">$45</div>
          <a href="#" target="_blank" class="health-btn">ACQUIRE SUPPLY</a>
        </div>
      </div>
    </section>

  </main>

  <style>
    :root{
      --bg:#06070a;
      --muted:#9aa4af;
      --accent-cyan:#00f0ff;
      --accent-green:#4ade80;
      --slate:#161b22;
      --glass:rgba(255,255,255,0.02);
    }

    :global(body){background:var(--bg);color:#e6eef6;font-family:Inter,ui-sans-serif,system-ui;}

    .store-shell{max-width:1150px;margin:0 auto;padding:3rem 1.25rem 5rem;display:flex;flex-direction:column;gap:2.25rem}
    .store-header h1{margin:0;font-size:1.9rem;letter-spacing:0.12em;text-transform:uppercase}
    .lead{color:var(--muted);margin:0.25rem 0 0}

    /* Cyber Grid */
    .section-electronics .sec-title{color:var(--accent-cyan);margin-bottom:0.8rem}
    .cyber-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.15rem;padding:1rem;border-radius:14px;background:linear-gradient(180deg, rgba(0,0,0,0.18), rgba(0,0,0,0.06));box-shadow:0 6px 30px rgba(0,255,240,0.03);border:1px solid rgba(0,255,240,0.08)}
    .prod-card{position:relative;padding:1.25rem;border-radius:12px;background:linear-gradient(180deg,#021016,rgba(0,0,0,0.2));box-shadow:0 8px 30px rgba(0,255,240,0.04);border:1px solid rgba(0,255,240,0.06);overflow:hidden}
    .prod-card .timer-badge{position:absolute;right:10px;top:10px;background:rgba(0,0,0,0.45);backdrop-filter:blur(6px);padding:6px 8px;border-radius:999px;font-size:0.78rem;color:var(--accent-cyan)}
    .prod-card h3{margin:0 0 0.4rem;font-size:1.05rem}
    .prod-card .angle{color:var(--muted);font-size:0.92rem;margin:0 0 0.6rem}
    .price-tag{font-weight:700;color:#dbeafe}
    .price-tag .old-price{opacity:0.6;text-decoration:line-through;margin-right:0.6rem}
    .buy-btn{display:inline-block;margin-top:0.85rem;padding:10px 14px;border-radius:9px;background:linear-gradient(90deg,#00e5ff, #00b3cc);color:#00131a;text-decoration:none;font-weight:700}

    /* Minimal rows */
    .section-home .sec-title{color:#e6e9ec;margin-bottom:0.6rem}
    .minimal-rows{background:var(--slate);padding:0.9rem;border-radius:10px}
    .prod-row{display:flex;flex-direction:column;gap:0.35rem;padding:0.95rem;border-bottom:1px solid rgba(255,255,255,0.02)}
    .prod-row h3{margin:0;color:#ffffff}
    .buy-link{color:#9fb4c8;text-decoration:none;font-weight:600}

    /* Fashion cards */
    .section-fashion .sec-title{color:#f3efe9;margin-bottom:0.6rem}
    .fashion-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}
    .fashion-card{border:1px solid rgba(255,255,255,0.06);background:linear-gradient(180deg,#0b0b0b,#0f0f10);padding:1rem;border-radius:8px;transition:transform .18s ease,border-color .18s}
    .fashion-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,0.12)}
    .fashion-card .timer-badge{display:inline-block;background:transparent;color:#cbd5e1;font-size:0.85rem;margin-bottom:0.5rem}
    .fashion-btn{display:inline-block;margin-top:0.6rem;padding:8px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);color:#fff;text-decoration:none}

    /* Health columns */
    .section-health .sec-title{color:var(--accent-green);margin-bottom:0.6rem}
    .health-columns{display:flex;flex-direction:column;gap:0.6rem}
    .health-col{background:linear-gradient(180deg,#062012,#04160f);padding:1rem;border-left:4px solid var(--accent-green);border-radius:6px}
    .health-btn{display:inline-block;margin-top:0.6rem;padding:8px 12px;border-radius:8px;background:linear-gradient(90deg,#22c55e,#4ade80);color:#02210b;text-decoration:none;font-weight:700}

    /* Shared */
    .sec-title{font-size:0.95rem;letter-spacing:0.14em;text-transform:uppercase}
    .deal-card .countdown{font-weight:800;margin-left:6px}
    @media (max-width:720px){.cyber-grid,.fashion-cards{grid-template-columns:1fr}}
  </style>

  <script>
// @ts-nocheck
    // Live countdowns for elements with data-expires
    (function(){
      const nodes = Array.from(document.querySelectorAll('[data-expires]'));
      if(!nodes.length) return;

      function msToParts(ms){
        const s = Math.floor(ms/1000);
        const days = Math.floor(s/86400);
        const hours = Math.floor((s%86400)/3600);
        const minutes = Math.floor((s%3600)/60);
        const seconds = s%60;
        return {days,hours,minutes,seconds};
      }

      nodes.forEach(el=>{
        const ts = el.getAttribute('data-expires');
        const target = new Date(ts);
        if(Number.isNaN(target.getTime())) return;

        const cd = el.querySelector('.countdown');

        function update(){
          const diff = target.getTime() - Date.now();
          if(diff <= 0){
            el.style.display = 'none';
            clearInterval(interval);
            return;
          }
          const parts = msToParts(diff);
          const text = `${parts.days} days ${parts.hours}h ${parts.minutes}m ${parts.seconds}s`;
          if(cd) cd.textContent = text;
        }

        update();
        const interval = setInterval(update,1000);
      });
    })();
  </script>
</MainLayout>

