---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Fetch all the reviews automatically!
const allReviews = await getCollection('reviews');
---

<Layout title="Product Reviews">
  <main class="luxury-container">
    <h1 class="page-title">All Reviews</h1>
    <hr class="divider" />
    
    <div class="reviews-grid">
      {allReviews.map(review => (
        <a href={`/reviews/${review.id || review.id}`} class="review-card-link">
          <article class="review-card">
            <h2>{review.data.title}</h2>
            <div class="meta-row">
              <span class="category-tag">{review.data.category}</span>
             <span class="rating-stars">{"★".repeat(parseInt(review.data.priceRating))}</span>
            </div>
            <p class="description">{review.data.description}</p>
          </article>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  :root {
    --gold-glow: rgba(212, 175, 55, 0.3);
    --gold-bright: #d4af37;
    --glass-bg: rgba(255, 255, 255, 0.02);
    --glass-border: rgba(255, 255, 255, 0.05);
  }

  .luxury-container {
    max-width: 840px;
    margin: 0 auto;
    padding: 6rem 2rem;
  }

  .page-title {
    font-size: 2.8rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    background: linear-gradient(to right, #fff, rgba(255, 255, 255, 0.4));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .divider {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2rem 0 3rem 0;
  }

  .reviews-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .review-card-link {
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  /* --- THE ULTRA-SLEEK HOVER MAGIC --- */
  .review-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 2.5rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    
    /* Smooth transition for every single moving part */
    transition: 
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    
    position: relative;
    overflow: hidden;
  }

  /* Subtle inner light reflection */
  .review-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 100%);
    pointer-events: none;
  }

  /* Triggering the premium state on hover */
  .review-card-link:hover .review-card,
  .review-card-link:focus-visible .review-card {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.4); /* ENIG Gold tint border */
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.4),
      0 0 30px var(--gold-glow); /* Soft gold neon halo */
  }

  h2 {
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
    transition: color 0.3s ease;
  }

  /* Title subtly illuminates on hover */
  .review-card-link:hover h2 {
    color: var(--gold-bright);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .category-tag {
    opacity: 0.4;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    transition: opacity 0.3s ease, border-color 0.3s ease;
  }

  .review-card-link:hover .category-tag {
    opacity: 0.8;
    border-color: rgba(212, 175, 55, 0.3);
  }

  .rating-stars {
    color: var(--gold-bright);
    letter-spacing: 0.2em;
    opacity: 0.8;
    text-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
  }

  .description {
    opacity: 0.6;
    line-height: 1.7;
    font-size: 0.95rem;
    transition: opacity 0.3s ease;
  }

  .review-card-link:hover .description {
    opacity: 0.85;
  }
</style>