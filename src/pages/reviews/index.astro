---
import Layout from '../../layouts/Layout.astro';

const reviewModules: any = import.meta.glob('../../content/reviews/*.md', { eager: true });
const reviews = Object.entries(reviewModules)
  .map(([filePath, module]: [string, any]) => ({
    slug: filePath.split('/').pop()?.replace(/\.md$/, '') ?? '',
    frontmatter: module.frontmatter,
  }))
  .sort((a, b) => (a.frontmatter.title || '').localeCompare(b.frontmatter.title || ''));
---
<Layout title="Review Database | MahuTop">

<div class="page-shell">
  <main class="database-shell">
    <header class="logs-header-container page-header">
      <h1 class="font-mono text-xl tracking-wider" data-i18n-key="logsTitle">
        SYSTEM LOGS // REVIEWS_DATABASE
      </h1>
      <p class="text-sm text-gray-400 mt-2 page-copy" data-i18n-key="reviewsSub">
        Encrypted review logs, ready for audit and deeper analysis.
      </p>
    </header>

    <div class="search-wrapper">
      <input type="text" id="log-search" data-i18n-placeholder="logsSearchPlaceholder" placeholder="FILTER LOGS // ENTER SYSTEM KEYWORDS..." autocomplete="off" />
    </div>

    <section class="logs-grid" aria-label="Review logs database">
      {reviews.map((review) => (
        <a class="log-row" href={`/reviews/${review.slug}`}>
          <span class="row-title">{review.frontmatter.title}</span>
          <span class="row-date">{review.frontmatter.date ?? ''}</span>
          <span class="row-description">{review.frontmatter.description}</span>
        </a>
      ))}
    </section>
  </main>
</div>
</Layout>

<style>
  :global(html), :global(body) {
    min-height: 100%;
    margin: 0;
    background: #06070a !important;
    color: #c9d1d9;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }

  .page-shell {
    min-height: 100vh;
    background: #06070a;
  }

  .database-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 2rem 0 1.5rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c9d1d9;
  }

  .page-copy {
    margin: 0;
    color: #8b949e;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .logs-grid {
    display: grid;
    gap: 0.75rem;
  }

  .log-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(160px, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 1.2rem 1.3rem;
    border: 1px solid #30363d;
    border-radius: 0.85rem;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .log-row:hover,
  .log-row:focus-visible {
    border-color: #58a6ff;
    background: rgba(88, 166, 255, 0.06);
    transform: translateY(-1px);
  }

  .row-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .row-date {
    font-size: 0.9rem;
    color: #8b949e;
    text-align: end;
  }

  html[dir="rtl"] .row-date {
    text-align: start;
  }

  .row-description {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    color: #8b949e;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .log-row {
      grid-template-columns: 1fr;
    }
    .row-date {
      text-align: start;
    }
  }

  .search-wrapper {
    margin-bottom: 1.25rem;
  }

  #log-search {
    width: 100%;
    background: #0d1117;
    border: 1px solid #30363d;
    color: #c9d1d9;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    padding: 0.95rem 1rem;
    border-radius: 0.75rem;
    outline: none;
    transition: box-shadow 180ms ease, border-color 180ms ease;
  }

  #log-search:focus {
    border-color: #58a6ff;
    box-shadow: 0 0 0 4px rgba(88, 166, 255, 0.12);
  }
</style>

<script>
// @ts-nocheck
  const searchInput = document.getElementById('log-search');
  const logRows = Array.from(document.querySelectorAll('.log-row'));

  if (searchInput && logRows.length) {
    searchInput.addEventListener('input', (event) => {
      const query = (event.target.value || '').trim().toLowerCase();

      logRows.forEach((row) => {
        const title = row.querySelector('.row-title')?.textContent?.toLowerCase() ?? '';
        const description = row.querySelector('.row-description')?.textContent?.toLowerCase() ?? '';
        const date = row.querySelector('.row-date')?.textContent?.toLowerCase() ?? '';
        const matches = query.length === 0 || title.includes(query) || description.includes(query) || date.includes(query);

        row.style.display = matches ? '' : 'none';
      });
    });
  }
</script>
